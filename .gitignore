# Terraform local state (contains plaintext secrets, e.g. the IAM access key)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform provider plugins / working dir (re-created by `terraform init`)
.terraform/

# Variable files that may hold secrets
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated by main.tf (local_file.env): AWS credentials
flask_app/.env
